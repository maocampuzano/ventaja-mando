# Copie este archivo como .env (local) o cargue estas variables en el entorno de nube.
# Nunca suba el .env con valores reales al repositorio.

# Supabase (fase 1). Ver supabase/LEEME.md, «Pasar esto a su proyecto de Supabase».
SUPABASE_URL=                     # solo https://<proyecto>.supabase.co, sin /rest/v1 al final
SUPABASE_PUBLISHABLE_KEY=         # pública (sb_publishable_… o la antigua «anon»); puede ir en el navegador y en la app
SUPABASE_SECRET_KEY=              # secreta (sb_secret_… o la antigua «service_role»); solo en el servidor y en las Edge Functions
SUPABASE_DB_URL=                  # cadena de conexión a Postgres; secreta. El entorno de nube no permite usarla (puerto 5432)
SUPABASE_ACCESS_TOKEN=            # token personal (sbp_…); secreto. Lo usa supabase/scripts/aplicar-remoto.mjs para migrar

# Mapas (fase 2)
MAPTILER_KEY=

# IA (fase 4)
ANTHROPIC_API_KEY=
MODELO_STRATEGOS=claude-sonnet-5-5
MODELO_LECTURA=claude-sonnet-5-5
MODELO_CLASIFICACION=claude-haiku-5-5

# Pauta (fase 5)
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Comunicaciones (fase 7)
SMS_PROVEEDOR=
SMS_API_KEY=
CORREO_PROVEEDOR=
CORREO_API_KEY=
