# Copie este archivo como .env (local) o cargue estas variables en el entorno de nube.
# Nunca suba el .env con valores reales al repositorio.

# Supabase (fase 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo en el servidor y en las Edge Functions; nunca en el navegador ni en la app

# Mapas (fase 2)
