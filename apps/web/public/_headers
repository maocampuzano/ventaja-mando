# Cabeceras de seguridad de Cloudflare Pages.
# no-referrer: el enlace de invitación lleva un código; no debe filtrarse a otros sitios.
# noindex: el entorno de prueba no aparece en buscadores.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow

# MapLibre va aparte, en una carpeta con su versión: se puede guardar en caché para siempre.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*.mjs
  Content-Type: text/javascript; charset=utf-8
